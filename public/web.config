<?xml version="1.0" encoding="UTF-8"?>
<!-- Windows / IIS hosting only. Delete this file if your host runs Apache. Add new page paths to the rule pattern. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Known routes load the app" stopProcessing="true">
          <match url="^(?:|accessibility|company|company/careers|company/profile|contact|cookies|legal|managed\-security\-operations|privacy|products|products/compare|pudica\-autonomy|resources|resources/executive\-assurance\-summary|resources/frameworks|resources/sample\-change\-decision|security\-disclosure|services|services/application\-security\-governance|services/backup\-recovery\-assurance|services/certification\-readiness|services/digital\-forensics\-training\-investigations|services/enterprise\-risk\-vendor\-assurance|services/grc\-as\-a\-service|services/incident\-readiness\-response|services/it\-infrastructure\-security\-operations|services/managed\-detection\-siem\-operations|services/managed\-identity\-it\-operations|services/nativetrust\-endpoint|services/privacy\-operations\-dpo\-support|services/secure\-cloud\-migration|services/security\-baselines\-configuration\-drift|services/vulnerability\-compliance\-remediation\-management|services/vulnerability\-remediation|solutions/application\-trust|solutions/incident\-recovery\-readiness|solutions/nativetrust|solutions/secure\-business\-transformation|support|terms)/?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="File" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
